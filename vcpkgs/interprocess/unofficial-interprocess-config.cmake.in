get_filename_component(_INTERPROCESS_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

if(NOT TARGET unofficial::interprocess::interprocess)
    add_library(unofficial::interprocess::interprocess @INTERPROCESS_LIBRARY_TYPE@ IMPORTED)

    set_target_properties(
        unofficial::interprocess::interprocess
        PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_INTERPROCESS_PREFIX}/include"
        INTERFACE_LINK_LIBRARIES "@INTERPROCESS_NATIVE_LIBS@"
    )

    if(WIN32)
        if(@INTERPROCESS_IS_DYNAMIC@)
            if(MINGW)
                set(_INTERPROCESS_IMPLIB "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.dll.a")
            else()
                set(_INTERPROCESS_IMPLIB "${_INTERPROCESS_PREFIX}/lib/interprocess_ffi.lib")
            endif()

            set_target_properties(
                unofficial::interprocess::interprocess
                PROPERTIES
                IMPORTED_IMPLIB "${_INTERPROCESS_IMPLIB}"
                IMPORTED_LOCATION "${_INTERPROCESS_PREFIX}/bin/interprocess_ffi.dll"
                INTERFACE_COMPILE_DEFINITIONS "IPCPP_SHARED=1"
            )
        else()
            if(MINGW)
                set(_INTERPROCESS_IMPLIB "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.a")
            else()
                set(_INTERPROCESS_IMPLIB "${_INTERPROCESS_PREFIX}/lib/interprocess_ffi.lib")
            endif()

            set_target_properties(
                unofficial::interprocess::interprocess
                PROPERTIES
                IMPORTED_LOCATION "${_INTERPROCESS_IMPLIB}"
            )
        endif()
    elseif(APPLE)
        if(@INTERPROCESS_IS_DYNAMIC@)
            set(_INTERPROCESS_LOCATION "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.dylib")
        else()
            set(_INTERPROCESS_LOCATION "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.a")
        endif()

        set_target_properties(
            unofficial::interprocess::interprocess
            PROPERTIES
            IMPORTED_LOCATION "${_INTERPROCESS_LOCATION}"
        )
    else()
        if(@INTERPROCESS_IS_DYNAMIC@)
            set(_INTERPROCESS_LOCATION "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.so")
        else()
            set(_INTERPROCESS_LOCATION "${_INTERPROCESS_PREFIX}/lib/libinterprocess_ffi.a")
        endif()

        set_target_properties(
            unofficial::interprocess::interprocess
            PROPERTIES
            IMPORTED_LOCATION "${_INTERPROCESS_LOCATION}"
        )
    endif()
endif()
