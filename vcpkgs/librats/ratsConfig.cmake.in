# Generated by the librats vcpkg port for the upstream prebuilt release.
get_filename_component(_RATS_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(NOT TARGET rats::rats)
    add_library(rats::rats STATIC IMPORTED)
    set_target_properties(rats::rats PROPERTIES
        IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
        IMPORTED_LOCATION_RELEASE "${_RATS_PREFIX}/lib/@_RATS_LIBNAME@"
        IMPORTED_LOCATION_DEBUG "${_RATS_PREFIX}/debug/lib/@_RATS_LIBNAME@"
        INTERFACE_INCLUDE_DIRECTORIES "${_RATS_PREFIX}/include"
        INTERFACE_LINK_LIBRARIES "@_RATS_LINK_LIBS@"
    )
endif()
